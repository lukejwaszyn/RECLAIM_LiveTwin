# Copy to C:\ProgramData\RECLAIM\engine\secrets\reclaim-ingest.env on the
# Windows Server 2025 VM, replace the values, and restrict the file's NTFS ACL
# to Administrators, SYSTEM, and the service identity. Do not commit real tokens.
# The PowerShell service runner loads them into the process environment; never
# place tokens on a command line or in the WinSW XML.
RECLAIM_INGEST_TOKEN=replace-with-a-long-random-secret
# Required in production: protects GET /state /manifest /history /command.
# Give this value to the Convene publisher and its native .stp visualization. /health
# remains open for liveness probes. The production runner rejects an empty or
# identical read token.
RECLAIM_READ_TOKEN=replace-with-a-different-long-random-secret
