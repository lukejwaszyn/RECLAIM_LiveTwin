# Copy to /etc/reclaim/reclaim-ingest.env, set mode 600 root:root, and replace
# the values. Do not commit real tokens. Tokens are consumed from the
# environment only — never place them on a command line or in a unit file.
RECLAIM_INGEST_TOKEN=replace-with-a-long-random-secret
# Optional but recommended: protects GET /state /manifest /history /command.
# Give this value to the Convene publisher and its native .stp visualization. /health
# remains open for liveness probes. Leave empty to keep GETs open (only safe
# if the port is loopback-only behind the tunnel AND the tunnel route is
# access-controlled).
RECLAIM_READ_TOKEN=replace-with-a-different-long-random-secret
