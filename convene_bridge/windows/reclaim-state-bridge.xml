<!-- WinSW 3.x template. The installer substitutes the {{...}} values. -->
<service>
  <id>RECLAIMStateBridge</id>
  <name>RECLAIM Convene State Bridge</name>
  <description>Publishes authenticated loopback RECLAIM engine state for the existing VM Convene agent.</description>
  <executable>{{PYTHON_EXE}}</executable>
  <arguments>-m convene_bridge --config &quot;{{CONFIG_PATH}}&quot;</arguments>
  <workingdirectory>{{APP_DIR}}</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>15sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <serviceaccount>
    <username>{{SERVICE_ACCOUNT}}</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <keepFiles>14</keepFiles>
  </log>
</service>
